# MongoDB connection string. If unset, the app runs on mock data.
# Replace with your own. Never commit real credentials.
MONGODB_URI=""

# AI provider: "mock" (default), "openai", "anthropic", "gemini", "openrouter"
AI_PROVIDER="mock"

# AI provider API keys (only required when AI_PROVIDER is set to that provider)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
OPENROUTER_API_KEY=""

# Image generation provider (e.g. OpenAI Image 2)
IMAGE_API_KEY=""

# Creator / prospect data (Tikhub)
TIKHUB_API_KEY=""

# Outreach automation (Apify for Instagram DMs)
APIFY_API_KEY=""

# Email provider (Gmail / SMTP)
EMAIL_API_KEY=""

# Social platform APIs
TIKTOK_API_KEY=""
INSTAGRAM_API_KEY=""

# Auth (NextAuth.js — credentials provider backed by MongoDB)
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
